# Copy this file to .env and fill in what you need. Everything here is optional: the site runs
# with an empty .env.

# Only needed by `npm run fetch:tmdb`, which backfills LIVE-ACTION character artwork (TV and
# film) from TMDB. Free: sign in at https://www.themoviedb.org/, then Settings > API > request a
# Developer key.
TMDB_API_KEY=
