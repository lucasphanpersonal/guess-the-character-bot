# Copy this file to .env and fill in the values from the Discord Developer Portal.
# https://discord.com/developers/applications

# Bot > Token (a long string with two dots in it -- NOT the "Public Key" from
# General Information, which is a different, dot-free value).
DISCORD_TOKEN=

# General Information > Application ID.
CLIENT_ID=

# Optional. Your test server's ID (enable Developer Mode in Discord, then right-click the
# server icon > Copy Server ID). Guild-scoped command registration is instant; leave this
# blank to register globally, which can take up to an hour to propagate.
GUILD_ID=

# Optional. Only needed by `npm run fetch:tmdb`, which backfills LIVE-ACTION character
# artwork (TV and film) from TMDB. Free: sign in at https://www.themoviedb.org/, then
# Settings > API > request a Developer key.
TMDB_API_KEY=
