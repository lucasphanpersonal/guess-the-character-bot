node_modules/

# Secrets -- .env.example is committed, .env is not.
.env

# Runtime database (created on first run).
data/bot.sqlite
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
# Manual backups taken before a bulk re-seed.
data/*.sqlite.bak-*
data/image-clean-*.json
data/anilist-renames-*.csv
data/anilist-renames-*.json

# Voice clips the retired Discord bot generated. Still ignored, so a machine that has them stays clean.
data/sounds/

# Locally cached character artwork (read-through cache; refills itself on demand).
data/image-cache/

# Self-signed dev TLS cert for `npm run web:secure` (machine-local, regenerated on demand).
data/dev-tls.*

# Machine-local Claude Code settings (absolute paths, per-developer).
.claude/settings.local.json

# Logs from the retired Discord bot -- machine-local, kept ignored for machines that still have them.
data/bot-restart.log*
data/discord-bot.log

# The host keeper's log, state and stop request (scripts/host-keeper.js) -- machine-local.
data/host-keeper/
