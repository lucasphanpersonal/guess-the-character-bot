node_modules/

# Secrets -- .env.example is committed, .env is not.
.env

# Runtime database (created on first run).
data/bot.sqlite
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
data/*.sqlite-shm
# Manual backups taken before a bulk re-seed.
data/*.sqlite.bak-*

# Generated by `npm run generate:sounds` (runs automatically on npm install).
data/sounds/

# Self-signed dev TLS cert for `npm run web:secure` (machine-local, regenerated on demand).
data/dev-tls.*

# Machine-local Claude Code settings (absolute paths, per-developer).
.claude/settings.local.json

# Bot stdout/stderr from a scripted restart -- machine-specific noise, not project files.
data/bot-restart.log*
