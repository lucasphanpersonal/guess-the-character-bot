{
  "name": "guess-the-character-bot",
  "version": "1.0.0",
  "description": "Guess the Character (Hedbanz-style) and Draw the Character: party games on the web, as seen on The Best in Jest",
  "main": "src/web/server.js",
  "type": "commonjs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node src/web/server.js",
    "web": "node src/web/server.js",
    "web:secure": "cross-env WEB_HTTPS=1 node src/web/server.js",
    "test": "node test/run.js",
    "check:web-socket": "node scripts/check-web-socket.js",
    "seed:pokemon": "node scripts/seed-pokemon-list.js",
    "seed:lol": "node scripts/seed-league-of-legends.js",
    "seed:dota2": "node scripts/seed-roster.js data/seed/dota-2.json",
    "seed:deadlock": "node scripts/seed-roster.js data/seed/deadlock.json",
    "seed:persona": "node scripts/seed-roster.js data/seed/persona.json",
    "seed:wikidata": "node scripts/seed-wikidata-characters.js",
    "seed:anilist": "node scripts/seed-anilist-characters.js",
    "seed:people": "node scripts/seed-wikidata-people.js",
    "browse": "node scripts/browse-characters.js",
    "select:lists": "node scripts/select-lists.js",
    "backup": "node scripts/backup-db.js",
    "reset:seeded": "node scripts/reset-seeded-lists.js",
    "backfill:popularity": "node scripts/backfill-popularity.js",
    "fetch:anilist": "node scripts/fetch-anilist-characters.js",
    "fetch:wikidata": "node scripts/fetch-wikidata-characters.js",
    "fetch:people": "node scripts/fetch-wikidata-people.js",
    "fetch:rosters": "node scripts/fetch-hero-rosters.js",
    "fetch:work-fame": "node scripts/fetch-work-fame.js",
    "fetch:tmdb": "node scripts/fetch-tmdb-images.js",
    "fetch:fandom": "node scripts/fetch-fandom-images.js",
    "backfill:fame": "node scripts/backfill-fame-from-order.js",
    "check:images": "node scripts/check-image-urls.js",
    "start:all": "node scripts/start-all.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "selfsigned": "^2.4.1"
  }
}
